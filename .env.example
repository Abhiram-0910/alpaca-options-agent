# Alpaca paper trading account (must be a FRESH account for final hackathon submission)
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER_TRADE=true

# LLM reasoning engine for the agent — set ONE of these two blocks (Anthropic or OpenAI).
# Anthropic (agent/live_agent.py, agent/multi_agent.py):
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5
# OpenAI (agent/live_agent_openai.py):
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional: Featherless AI (open-source model inference credits from the hackathon sponsor)
FEATHERLESS_API_KEY=

# Optional guardrails (see agent/config.py, agent/risk/gates.py). All have safe defaults.
# MIN_DTE=1            # 1-4: every expiry in the judged window is 1-3 days out
# MAX_DTE=4
# MAX_ALLOCATION_USD_PER_TRADE=2000
# MAX_TOTAL_OPTIONS_ALLOCATION_USD=10000
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional position/order management (see agent/order_manager.py). All have safe defaults.
# FORCE_CLOSE_DTE=0   # disabled: see agent/session_window.py for the real expiry rule
# POSITION_PROFIT_TAKE_PCT=0.50
# POSITION_STOP_LOSS_PCT=0.75
# STALE_ORDER_MINUTES=60
